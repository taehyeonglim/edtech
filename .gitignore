# MkDocs build output
site/

# tools/ 실행 부산물
__pycache__/

node_modules/

# Candidate, release, and private audit material are local-only.
.candidate/
.release/
.evidence/
.bindings/
# ─────────────────────────────────────────────────────────────
# 비공개 원천 자료 — 이 저장소는 PUBLIC 이다. 절대 커밋하지 말 것.
# ─────────────────────────────────────────────────────────────
# PI 사적 강의 자료 (학기별 gslides/pptx/pdf + 학지사 교재 목차 hwp).
# 저작권 자료이므로 공개 저장소에 올라가면 안 된다.
Previous_lecture_content/

# 에이전트 제작 툴의 로컬 작업 산출물 (composed.md, DESIGN.md, 검수 리포트,
# 중간 deck/이미지). 공개본의 source of truth 는 chapters/ 와 docs/ 다.
content/

# 세션 로그 (gjc)
.gjc/

# 내부 작업 문서 (spec/plan/핸드오프). 교재 목차의 저작권 재구성 근거 등
# 내부 판단 기록이 들어 있어 기본 비공개. 공개하려면 이 줄만 지우면 된다.
docs-internal/

